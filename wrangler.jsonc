{
  // Cloudflare Workers static site. Cloudflare runs `npm run build`, then serves ./dist.
  "name": "mfl-workshop",
  "compatibility_date": "2026-10-01",
  // Needed for branch preview builds (npx wrangler preview). Can stay empty.
  "previews": {},
  // The site's own address. Cloudflare creates the DNS records on deploy.
  "routes": [
    { "pattern": "themflworkshop.co.uk", "custom_domain": true },
    { "pattern": "www.themflworkshop.co.uk", "custom_domain": true }
  ],
  // Keep the old workers.dev address working so links already shared still open.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
